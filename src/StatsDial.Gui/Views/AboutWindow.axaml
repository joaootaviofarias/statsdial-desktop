<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StatsDial.Desktop.Views.AboutWindow"
        Title="About Stats Dial"
        Width="400" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="/Assets/icon.ico">

	<!-- Main Rounded Container -->
	<Border Background="{StaticResource AppBackgroundBrush}"
            CornerRadius="12"
            ClipToBounds="True">

		<Grid RowDefinitions="40,*">

			<!-- Custom Title Bar -->
			<Grid Grid.Row="0" Background="Transparent" PointerPressed="TitleBar_PointerPressed">

				<!-- Left: Icon & App Name -->
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8" IsHitTestVisible="False">
					<Image Source="/Assets/icon.ico" Width="18" Height="18"/>
					<TextBlock Text="About" FontWeight="SemiBold" VerticalAlignment="Center" />
				</StackPanel>

				<!-- Right: Close Button -->
				<Button HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="45"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_Click">
					<Button.Styles>
						<!-- Remove Hover Effect -->
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderBrush" Value="Transparent" />
						</Style>
						<!-- Remove Click/Pressed Effect -->
						<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
							<Setter Property="BorderBrush" Value="Transparent" />
						</Style>
					</Button.Styles>
					<TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" />
				</Button>
			</Grid>

			<!-- Original Content -->
			<Border Grid.Row="1" Classes="panel" Margin="20,0,20,20">
				<StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
					<TextBlock Text="STATS DIAL"
                               Classes="section-title"
                               FontSize="20"
                               HorizontalAlignment="Center" />

					<TextBlock Text="Version 1.0.0"
                               Classes="muted"
                               HorizontalAlignment="Center" />

					<TextBlock Text="Created by Joao Otavio"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

					<TextBlock Text="https://github.com/joaootaviofarias/statsdial-desktop"
                               Foreground="{StaticResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

					<TextBlock Text="Monitoring desktop metrics via ESP32."
                               Classes="muted"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0"/>

					<Button Content="CLOSE"
                            Classes="accent"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,0"
                            Click="Close_Click"/>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</Window>